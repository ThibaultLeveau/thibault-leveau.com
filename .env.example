SITE_ENVIRONMENT=development
# Chemin absolu ; en développement, l'absence de valeur utilise build/ dans le dépôt.
# SITE_STATIC_DIR=/home/deploy/projects/new.thibault-leveau.com/build
SITE_INDEXABLE=false
SITE_LOG_LEVEL=info
# Administration désactivée tant que ces paramètres ne sont pas renseignés.
SITE_ADMIN_ENABLED=false
SITE_ADMIN_USERNAME=admin
# Initialisation uniquement : 12 à 128 caractères, puis le compte est géré dans SQLite.
SITE_ADMIN_PASSWORD=
# Générer avec : uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
SITE_SECRET_KEY=
# Origine exacte, sans slash final. En production : https://new.thibault-leveau.com
SITE_ADMIN_ORIGIN=http://127.0.0.1:5173
# Chemin absolu local ; Compose utilise /app/data/admin.sqlite3 sur son volume dédié.
# SITE_ADMIN_DB_PATH=/home/deploy/projects/new.thibault-leveau.com/data/admin.sqlite3
# Tag immuable conseillé pour le déploiement : SHA du commit validé.
IMAGE_TAG=local
